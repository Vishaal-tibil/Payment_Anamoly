# Copy this file to .env and fill in real values. .env itself is gitignored --
# never commit real secrets.
#
# Every variable here is optional: with an empty .env the API runs exactly as
# it does for local development (localhost CORS, committed demo database).
# The overrides matter for a containerised/hosted run -- see README's
# Deployment section.

# --- Step 7: LLM Agent Layer (Mistral) ---------------------------------------
# Get keys at https://console.mistral.ai/. Without any key, AI narration
# returns a clear error and every other endpoint keeps working normally.
#
# QUOTA FAILOVER: set more than one key and narration automatically moves to
# the next when a key is exhausted, rate-limited or rejected. This is failover,
# not load balancing -- MISTRAL_API_KEY is always preferred and the spares stay
# untouched until it genuinely fails. Keys are tried in the order below.
#
# The numbered variables must be CONTIGUOUS (_2, then _3, ...). A gap ends the
# list, so a typo'd MISTRAL_API_KEY_3 leaves that key silently unused rather
# than quietly skipping a slot.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=

# Equivalent single-variable form, handy for container env vars. If set, it
# takes precedence and the numbered variables above are ignored entirely:
# MISTRAL_API_KEYS=key1,key2,key3

MISTRAL_MODEL=mistral-large-latest

# Verify every configured key actually works (one real call each, key values
# never printed):
#   python scripts/check_mistral_keys.py

# --- Database ----------------------------------------------------------------
# Defaults to the committed demo database at data/payments.db. In Docker this
# points at the mounted volume (/data/payments.db) so it survives redeploys.
# DB_PATH=data/payments.db

# --- CORS --------------------------------------------------------------------
# Leave unset for local development: any localhost port is allowed, which is
# what Vite needs (it auto-increments past 5173 when that port is taken).
#
# For a hosted frontend, set a comma-separated allowlist of EXACT origins.
# Include both Firebase domains, plus any custom domain -- miss one and the
# browser blocks every request from it. NOTE: once this is set, localhost is
# no longer allowed, so a local frontend can't call this backend.
# CORS_ALLOW_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
